+static bool
+parse_usb_serial_hex_field(const char *serial, const char *field, uint16_t *value) {
+	const size_t field_len = strlen(field);
+	bool found = false;
+	uint16_t result = 0;
+
+	/* DFU identity fields are space-delimited, unsigned hexadecimal tokens.
+	 * Reject missing, malformed, overflowing and duplicate identity fields. */
+	while(*serial != '\0') {
+		const char *end;
+		while(*serial == ' ') ++serial;
+		end = strchr(serial, ' ');
+		if(end == NULL) end = serial + strlen(serial);
+		if((size_t)(end - serial) >= field_len && strncmp(serial, field, field_len) == 0) {
+			const char *digit = serial + field_len;
+			if(found || digit == end) return false;
+			for(; digit < end; ++digit) {
+				unsigned n;
+				if(*digit >= '0' && *digit <= '9') n = (unsigned)(*digit - '0');
+				else if(*digit >= 'a' && *digit <= 'f') n = (unsigned)(*digit - 'a') + 10U;
+				else if(*digit >= 'A' && *digit <= 'F') n = (unsigned)(*digit - 'A') + 10U;
+				else return false;
+				if(result > (UINT16_MAX - n) / 16U) return false;
+				result = (uint16_t)(result * 16U + n);
+			}
+			found = true;
+		}
+		serial = end;
+	}
+	if(found) *value = result;
+	return found;
 }
 
