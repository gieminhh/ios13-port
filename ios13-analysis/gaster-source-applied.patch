+	}
+	/* Exercise the RPC without invoking AES or copying any payload bytes. */
+	request[2] = request[3] = insecure_memory_base + sizeof(result);
+	if(!gaster_command(handle, request, sizeof(request), &response, sizeof(result))) {
+		return false;
+	}
+	memcpy(result, response, sizeof(result));
+	free(response);
+	ret = result[0] == DONE_MAGIC && result[1] == request[2];
+	if(ret) {
+		puts("RPC probe succeeded (DONE_MAGIC, zero-length memcpy); AES was not executed.");
+	} else {
+		fputs("RPC probe returned an invalid marker or return value.\n", stderr);
+	}
+	return ret;
