+static bool
+gaster_probe(usb_handle_t *handle) {
+	uint64_t request[5] = { MEMC_MAGIC, 0, 0, 0, 0 }, result[2];
+	uint8_t *response;
+	bool ret;
+
+	if(!gaster_checkm8(handle)) {
